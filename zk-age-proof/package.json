{
  "name": "zk-age-proof",
  "version": "1.0.0",
  "description": "Zero-knowledge age verification demo: Circom + Groth16 (snarkjs) + EdDSA-Poseidon",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "issue": "ts-node scripts/issuer.ts",
    "prove": "ts-node scripts/prover.ts",
    "verify": "ts-node scripts/verifier.ts",
    "demo": "ts-node demo/run_demo.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "circom2": "^0.2.23",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 120000,
    "roots": [
      "<rootDir>/test"
    ]
  },
  "engines": {
    "node": ">=18.3"
  }
}
