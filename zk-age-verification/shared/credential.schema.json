{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zk-age-verification.local/credential.schema.json",
  "title": "ZK age credential",
  "description": "The JSON the Issuer embeds in the ID card PNG (tEXt chunk 'zkcred', base64-encoded). Only Poseidon([ID_Number, dob]) is signed; name, address and contact are unsigned display data. All big numbers are decimal strings, never JSON numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "address", "dob", "ID_Number", "issuerPubKey", "signature"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "address": { "type": "string", "minLength": 1, "maxLength": 120 },
    "contact": { "type": "string", "maxLength": 100 },
    "dob": {
      "description": "Date of birth as YYYYMMDD, e.g. \"20080315\"",
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "ID_Number": {
      "description": "128-bit random integer chosen by the Issuer",
      "$ref": "#/$defs/decimal"
    },
    "issuerPubKey": {
      "description": "Issuer EdDSA (BabyJubJub) public key, normal (non-Montgomery) form",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/decimal" },
        "y": { "$ref": "#/$defs/decimal" }
      }
    },
    "signature": {
      "description": "EdDSA-Poseidon signature over Poseidon([ID_Number, dob])",
      "type": "object",
      "additionalProperties": false,
      "required": ["R8x", "R8y", "S"],
      "properties": {
        "R8x": { "$ref": "#/$defs/decimal" },
        "R8y": { "$ref": "#/$defs/decimal" },
        "S": { "$ref": "#/$defs/decimal" }
      }
    }
  },
  "$defs": {
    "decimal": {
      "description": "Non-negative integer as a canonical decimal string (no sign, no leading zeros)",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    }
  }
}
