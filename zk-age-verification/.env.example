# .env.example
# Every configurable value, with demo defaults. To change one, copy this file to `.env`
# (docker compose reads .env automatically; for local runs, export the variables).

# ---- Issuer -------------------------------------------------------------------------------
# EdDSA private key of the mock government: 64 hex characters (32 bytes).
# DEMO ONLY, NEVER REUSE. This key is published on GitHub, so anyone can sign
# credentials with it. To make your own: `cd issuer && npm run keygen` with no key set.
ISSUER_PRIVATE_KEY=34e7d650cb34d80c2ff40f5d5cfee821eeac0597412afc232791f4b54ebae82a

# ---- Verifier -----------------------------------------------------------------------------
# Signs the session cookie. Leave empty to get a random secret at every start
# (sessions are then reset on restart, which is fine for the demo).
SESSION_SECRET=

# ---- Wallet -------------------------------------------------------------------------------
# Websites the wallet will send proofs to: exact origins, comma-separated.
ALLOWED_VERIFIER_ORIGINS=http://localhost:3003

# ---- Only for running modules locally without Docker (Docker sets these itself) -----------
# CHROMIUM_PATH=/usr/bin/chromium          # issuer: use this Chromium instead of Puppeteer's
# CHROMIUM_NO_SANDBOX=1                    # issuer: needed in containers or when running as root
# ARTIFACTS_DIR=../artifacts               # wallet + verifier: circuit build outputs
# ISSUER_PUBKEY_PATH=../shared/generated/issuer-pubkey.json   # keygen output / verifier input
# CHALLENGE_TTL_MS=120000                  # verifier: challenge lifetime (2 minutes)
# HOST=127.0.0.1                           # listen address of each server
